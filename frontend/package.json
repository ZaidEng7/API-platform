{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:client-portal": "ng serve client-portal",
    "start:admin-portal": "ng serve admin-portal --port 4201",
    "build:shared": "ng build shared",
    "build:client-portal": "ng build client-portal",
    "build:admin-portal": "ng build admin-portal",
    "build": "npm run build:shared && npm run build:client-portal && npm run build:admin-portal",
    "test": "ng test shared && ng test client-portal && ng test admin-portal",
    "lint": "ng lint",
    "format:check": "prettier --check .",
    "codegen": "bash scripts/generate-api-client.sh",
    "codegen:gateway": "bash scripts/generate-api-client.sh gateway http://localhost:8080/v3/api-docs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "angular-auth-oidc-client": "^21.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
