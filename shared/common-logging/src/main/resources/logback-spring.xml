<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured JSON console logging, auto-discovered by Spring Boot's
  LoggingSystem for any service that depends on this module (guide §14).
  MDC (including correlationId, set by common-web's CorrelationIdFilter or
  the Gateway) is included automatically by LogstashEncoder.

  Masking (guide §14: "Never logged: passwords, tokens, full national IDs,
  full IBANs, card data, document contents. Masking is enforced by the
  shared logging library, not by developer discipline"):
    - <path> fully masks the value of a field with that name, wherever it
      appears as structured JSON (e.g. via StructuredArguments/markers).
    - <valueMask> scans string field values (including free-text log
      messages) for a regex match and masks it in place — this is the net
      that catches IBANs/PANs embedded in a message string rather than
      logged as a named field.
-->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
            <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                <path>password</path>
                <path>token</path>
                <path>accessToken</path>
                <path>refreshToken</path>
                <path>secret</path>
                <path>apiKey</path>
                <path>authorization</path>
                <path>nationalId</path>
                <path>iban</path>
                <path>cardNumber</path>
                <path>cvv</path>

                <!-- IBAN-shaped value embedded in free text, e.g. a log message -->
                <valueMask>
                    <value>\b[A-Z]{2}\d{2}[A-Z0-9]{10,30}\b</value>
                </valueMask>
                <!-- Card-PAN-shaped digit run (13-19 digits, optionally spaced/dashed) -->
                <valueMask>
                    <value>\b(?:\d[ -]?){13,19}\b</value>
                </valueMask>

                <defaultMask>***MASKED***</defaultMask>
            </jsonGeneratorDecorator>
        </encoder>
    </appender>

    <!--
      Same JSON + masking as CONSOLE, written to disk so a node-level log
      agent (Filebeat/Fluent Bit/Data Prepper — shipper choice not made
      yet, see this module's README) can tail it. ${LOG_FILE} is populated
      automatically by Spring Boot's LoggingSystem when a service sets
      logging.file.name in its own application.yml — no <springProperty>
      needed, which also matters here since this file is loaded directly
      by JoranConfigurator (not full Spring Boot bootstrap) in this
      module's own tests.
    -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE:-logs/application.log}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE:-logs/application.log}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
            <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                <path>password</path>
                <path>token</path>
                <path>accessToken</path>
                <path>refreshToken</path>
                <path>secret</path>
                <path>apiKey</path>
                <path>authorization</path>
                <path>nationalId</path>
                <path>iban</path>
                <path>cardNumber</path>
                <path>cvv</path>
                <valueMask>
                    <value>\b[A-Z]{2}\d{2}[A-Z0-9]{10,30}\b</value>
                </valueMask>
                <valueMask>
                    <value>\b(?:\d[ -]?){13,19}\b</value>
                </valueMask>
                <defaultMask>***MASKED***</defaultMask>
            </jsonGeneratorDecorator>
        </encoder>
    </appender>

    <root level="${LOG_LEVEL_ROOT:-INFO}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <logger name="com.company" level="${LOG_LEVEL_APP:-INFO}"/>

</configuration>
