<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.company.integration</groupId>
  <artifactId>fund-mgmt-adapter</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <name>Fund Management Adapter (Phase 4 template)</name>
  <description>TEMPLATE anti-corruption layer (guide §9) — the third priority adapter, demonstrating the caching responsibility (§9.1) the other two didn't: fund NAV data only refreshes once a day after market close, so caching between refreshes isn't an optimization, it's the correct design for that freshness constraint. Not a real fund management integration; see README.md before pointing this at anything real.</description>

  <properties>
    <java.version>21</java.version>
    <!-- resilience4j-bom doesn't manage resilience4j-spring-boot4 yet
         (upstream gap: resilience4j/resilience4j#2427 — the artifact
         exists but was left out of the BOM) — explicit version instead. -->
    <resilience4j.version>2.4.0</resilience4j.version>
    <pact.version>4.7.3</pact.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.company.platform</groupId>
        <artifactId>platform-bom</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <!-- Forces the legacy RestClient onto HTTP/1.1 (Apache HttpClient5)
         instead of the JDK client's default HTTP/2-over-cleartext attempt —
         see LegacyFundMgmtClientConfig. Same real bug found building
         onboarding-adapter (RST_STREAM against WireMock's Jetty). -->
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- spring-boot-starter-aop was discontinued in Boot 4 (renamed to
         spring-boot-starter-aspectj, which is for actual compile/load-time
         weaving we don't need). resilience4j's @CircuitBreaker/@Retry/
         @Bulkhead aspects are genuine @Aspect-annotated classes though —
         without aspectjweaver on the classpath their autoconfiguration's
         @ConditionalOnClass(Aspect.class) silently fails and the
         annotations become no-ops (confirmed the hard way in
         crm-adapter). -->
    <dependency>
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjweaver</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-spring-boot4</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
    <dependency>
      <groupId>com.company.platform</groupId>
      <artifactId>common-web</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>com.company.platform</groupId>
      <artifactId>common-logging</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>3.13.2</version>
      <scope>test</scope>
    </dependency>
    <!-- Pact provider verification — real pair, Fund Service is the
         consumer (see contracts/README.md). spring7, not junit5spring, to
         match Spring Framework 7/Boot 4 (see customer-service's own pom
         for why). -->
    <dependency>
      <groupId>au.com.dius.pact.provider</groupId>
      <artifactId>spring7</artifactId>
      <version>${pact.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- FundMgmtAdapterPactVerificationTest needs the Pact Broker up
               with the consumer's pact already published — only true in
               the dedicated pact-contract-verification CI job. -->
          <excludedGroups>pact</excludedGroups>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Activated by the pact-contract-verification CI job only (`mvn test
         -Ppact-verification`) — see customer-service's own pom for why a
         profile is used instead of a command-line -DexcludedGroups=. -->
    <profile>
      <id>pact-verification</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <excludedGroups combine.self="override"></excludedGroups>
              <groups>pact</groups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
